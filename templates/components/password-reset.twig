<div class="small-container">

    <section class="login">
        <h1>Passwort zurücksetzen</h1>

        {% if craft.app.session.getFlash('notice') %}
            <div class="flash-message alert-success">{{ craft.app.session.getFlash('notice') }}</div>
        {% endif %} 
        
        {% if errors is defined %}
        <div class="alert-danger">
        Fehler:
        {{ ul(errors, {class: 'errors'}) }}
        </div>
        {% endif %}

        <form method="post" class="form" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('users/send-password-reset-email') }}
            {{ hiddenInput('successMessage', 'Sie erhalten in wenigen Minuten eine E-Mail für das Zurücksetzen des Passworts.'|hash) }}

            <div class="form-control">
                <label for="username">Benutzername oder E-Mail Adresse</label>
                {{ input('text', 'loginName', craft.app.user.rememberedUsername, {
                    id: 'loginName',
                    autocomplete: 'username'
                }) }}
            </div>

            <div class="form-actions">
                <button type="submit" class="button button-primary">Absenden</button>
            </div>
        </form>
    </section>
</div>
