<nav class="navbar" id="main-navigation">
    <div class="container">
        <section class="navigation">
            <input type="checkbox" id="active-state">
            <label class="icon" for="active-state">
                <img class="burger" src="/assets/icons/burger.svg" alt="burger">
                <img class="times" src="/assets/icons/times.svg" alt="close">
            </label>
            {% set nodes = craft.navigation.nodes('navigation').level(1).all() %}
            <div class="nav-wrapper">
                <ul class="navbar-nav">
                    {% for node in nodes %}
                        <li class="nav-item">
                            <a class="nav-link {% if node.hasActiveChild or node.active %}active{% endif %}" href="{{ node.url }}" title="{{ node.title }}">
                                {% if node.hasDescendants %}
                                    <span class="chevron">
                                        <img src="/assets/icons/chevron-right.svg" alt="">
                                    </span>
                                {% endif %}
                                {{ node.title }}
                            </a>
                            {% if node.hasDescendants %}
                                <ul class="dropdown-menu">
                                    {% for subnode in node.children.all() %}
                                        <li class="dropdown-item">
                                            <a class="dropdown-link {% if subnode.active %}active{% endif %}" data-content="{{ subnode.title }}" href="{{ subnode.url }}"
                                               title="{{ subnode.title }}">{{ subnode.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <div class="nav-actions">
                    <a href="mailto:{{ globalInformation.eMail }}" title="E-Mail an {{ globalInformation.eMail }} senden">
                        <svg viewBox="0 0 40 40">
                            <polygon points="6.741 11.085 20 19.37 33.259 11.085 6.741 11.085"/>
                            <polygon points="20 22.335 6.741 13.852 6.741 28.915 33.259 28.915 33.259 13.852 20 22.335"/>
                        </svg>
                    </a>
                    <a href="tel:+41{{ globalInformation.phone|slice(1)|replace(' ', '') }}" title="{{ globalInformation.phone }} anrufen">
                        <svg viewBox="0 0 40 40">
                            <path d="M10.9,25.733l2.944-3.051A1.5,1.5,0,0,1,16,22.725l1.483,1.536.293-.169a14.782,14.782,0,0,0,3.568-2.673,15.406,15.406,0,0,0,2.585-3.7l.159-.3L23.1,16.391l-.489-.508a1.629,1.629,0,0,1-.04-2.242l2.944-3.051a1.5,1.5,0,0,1,2.165.042l.83.865-.023.023a5.037,5.037,0,0,1,.684,1.249,5.342,5.342,0,0,1,.3,1.268c.388,3.339-1.084,6.39-5.081,10.531-5.525,5.723-9.978,5.29-10.17,5.269A4.833,4.833,0,0,1,13,29.518a4.766,4.766,0,0,1-1.2-.705l-.018.016-.841-.852a1.632,1.632,0,0,1-.039-2.244"/>
                        </svg>
                    </a>

                </div>
            </div>
            <a href="/" title="Sophie Guyer" class="navbar-brand">
                <img src="/assets/logos/sophie-guyer_logo.svg" alt="Sophie Guyer">
            </a>
        </section>
    </div>
</nav>
<script>
	addActiveToAnchorLinks();
    function addActiveToAnchorLinks(){
	    const links = document.querySelectorAll('[href*="#"]');
		const hash = window.location.hash;
		for (let i = 0; i < links.length; i++){
			const currentNode = links[i];
			currentNode.classList.remove('active');
			if(hash !== '' && currentNode.attributes.getNamedItem('href').nodeValue.includes(hash)){
				currentNode.classList.add('active');
            }
        }
    }
	window.onhashchange = function (){
		addActiveToAnchorLinks();
	}
</script>

