<div class="small-container">

    <section class="login">
        <h1>Login</h1>

        {% if errorMessage is defined %}
        <div class="alert-danger">
            <p>{{ errorMessage }}</p>
        </div>
        {% endif %}

        <form method="post" class="form" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('users/login') }}
            {{ redirectInput(cpUrl('assets/interneDateien')) }}

            <div class="form-control">
                <label for="username">Benutzername</label>
                {{ input('text', 'loginName', craft.app.user.rememberedUsername, {
                    id: 'loginName',
                    autocomplete: 'username'
                }) }}
            </div>
            <div class="form-control">
                <label for="password">Passwort</label>
                {{ input('password', 'password', null, {
                    id: 'password',
                    autocomplete: 'password'
                }) }}
            </div>
            <div class="form-group">
                <div class="form-control">
                    <label class="checkbox">
                        {{ input('checkbox', 'rememberMe', '1') }}
                        Angemeldet bleiben
                    </label>
                </div>
                <div class="form-control reset-actions">
                    <a href="{{ url('reset-password') }}">Passwort vergessen</a>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="button button-primary">Einloggen</button>
            </div>

        </form>
    </section>
</div>
