{
  "require": {
    "amici/craft-super-pdf": "^5.0.1",
    "carlcs/craft-uielementfields": "^2.0.3",
    "craftcms/cms": "4.17.15",
    "craftcms/redactor": "^3.1.0",
    "craftcms/security-patches": "dev-main",
    "fortrabbit/craft-object-storage": "^3.0.0",
    "kennethormandy/craft-s3securedownloads": "dev-feature/endpoint-v4.x",
    "mmikkel/incognito-field": "1.3.0",
    "psy/psysh": "^0.12.19",
    "sebastianlenz/linkfield": "^2.1.5",
    "solspace/craft-calendar": "^5.0.15",
    "spicyweb/craft-neo": "^4.4.1",
    "verbb/expanded-singles": "^2.0.5",
    "verbb/formie": "^2.2.19",
    "verbb/knock-knock": "^2.0.12",
    "verbb/navigation": "^2.1.1",
    "verbb/super-table": "^3.0.15",
    "vlucas/phpdotenv": "^5.4.0",
    "wrav/oembed": "^3.1.3"
  },
  "require-dev": {
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "internal\\": "modules/internal/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "scripts": {
    "pre-craft-update": [
      "@php craft db/backup --interactive=0 || exit 0"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "pre-update-cmd": "@pre-craft-update"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    },
    {
      "type": "vcs",
      "url": "https://github.com/webkp/craft-s3securedownloads.git",
      "no-api": true
    }
  ]
}
